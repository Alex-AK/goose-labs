---
import MinimalLayout from '../layouts/MinimalLayout.astro';
import Link from '../components/Link.astro';
---

<MinimalLayout title="Not found" description="There's no page at this address.">
  <main id="main-content" class="max-w-3xl mx-auto px-4 py-12 pb-0">
    <section class="mb-20 mt-24">
      <h1 class="text-4xl md:text-5xl text-orange-600 font-extrabold tracking-tight">Not found</h1>
      <p class="text-xl text-gray-700 mb-4 leading-relaxed">
        There's no page at this address. The <Link href="/">home page</Link> has every project log.
      </p>
    </section>
  </main>
</MinimalLayout>
